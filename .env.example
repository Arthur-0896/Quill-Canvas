# Quill Canvas Environment Configuration
# Copy this to .env and fill in your values

# AWS Configuration (Required for image generation)
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=us-east-1

# AWS S3 Bucket for storing generated images
AWS_S3_BUCKET=quill-canvas-images

# Application Environment
ENVIRONMENT=development  # or 'production'

# Backboard.io Integration (Optional)
BACKBOARD_API_KEY=your_backboard_api_key
BACKBOARD_ASSISTANT_ID=your_backboard_assistant_id
BACKBOARD_WORKFLOW_ID=your_backboard_workflow_id
BACKBOARD_BASE_URL=https://app.backboard.io/api

# Database Configuration (Optional - for persistence)
DATABASE_URL=postgresql://quill_user:quill_pass@localhost:5432/quill_canvas

# Redis Configuration (Optional - for WebSocket scaling)
REDIS_URL=redis://localhost:6379/0

# Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true  # Auto-reload on file changes (dev only)

# Logging
LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR, CRITICAL

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true
CORS_ALLOW_METHODS=GET,POST,PUT,DELETE
CORS_ALLOW_HEADERS=*

# Image Generation Settings
IMAGE_MODEL=amazon.titan-image-generator-v1  # AWS Bedrock model
IMAGE_WIDTH=512
IMAGE_HEIGHT=768
IMAGE_QUALITY=standard

# OpenAI Configuration (Optional - for enhanced scene extraction)
OPENAI_API_KEY=sk-...

# Feature Flags
ENABLE_DATABASE_PERSISTENCE=false
ENABLE_BACKBOARD_INTEGRATION=true
ENABLE_IMAGE_CACHING=true
ENABLE_DEBUG_MODE=false
